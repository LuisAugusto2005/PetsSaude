<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup para Android 11 e anteriores (API < 31).

   O que fica de fora: "vitalwatch-sessao.xml", que guarda os tokens do
   backend. Token de acesso em backup de nuvem sai do aparelho e pode ser
   restaurado em outro, e isso aqui da acesso a dado de saude de paciente.
   Quem restaura o app faz login de novo, que e o certo.

   O resto das preferencias (endereco do gateway, servidor e topico do ntfy)
   continua no backup: e configuracao chata de redigitar e nao e segredo.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="vitalwatch-sessao.xml" />
</full-backup-content>
