# Porta do servidor HTTP
PORT=3000

# development | test | production
NODE_ENV=development

# Mongo. Local: mongodb://127.0.0.1:27017/vitalwatch
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/vitalwatch?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vitalwatch

# Segredos JWT. Gere com: openssl rand -hex 48
# NUNCA reutilize o mesmo valor nos dois: o boot recusa se forem iguais.
JWT_ACCESS_SECRET=troque-por-48-bytes-aleatorios-em-hex-aaaaaaaaaaaa
JWT_REFRESH_SECRET=troque-por-48-bytes-aleatorios-em-hex-bbbbbbbbbbbb

# Tempo de vida dos tokens (formato do pacote ms: 15m, 7d, 12h)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Promove a admin, no boot, um usuario JA cadastrado com este e-mail - e apenas
# se nao existir nenhum admin ativo. Resolve o deploy de banco vazio, onde a
# conta de enfermagem nasce 'pending' e nao ha ninguem para aprovar.
# Nao cria conta: cadastre-se primeiro, depois defina a variavel e reinicie.
# Deixe vazio em desenvolvimento - o seed ja cria um admin.
BOOTSTRAP_ADMIN_EMAIL=

# Origens permitidas no CORS, separadas por virgula. * libera tudo (so em dev).
CORS_ORIGINS=*

# Nivel de log do pino: trace|debug|info|warn|error|fatal
LOG_LEVEL=info
