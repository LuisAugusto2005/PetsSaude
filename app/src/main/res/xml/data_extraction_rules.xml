<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup e transferencia para Android 12+ (API 31+).

   Mesma decisao do backup_rules.xml: os tokens do backend ("vitalwatch-sessao")
   ficam fora da nuvem E fora da transferencia direta entre aparelhos. Token
   que viaja e credencial de acesso a dado de saude viajando com ele.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vitalwatch-sessao.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vitalwatch-sessao.xml" />
    </device-transfer>
</data-extraction-rules>
